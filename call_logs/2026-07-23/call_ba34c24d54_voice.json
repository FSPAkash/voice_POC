    },
    {
      "id": "assistant_1784810212018",
      "role": "assistant",
      "text": "today थोड़ा ज़्यादा दूर लग रहा है. Next 2 business days के अंदर एक closer date बता दीजिए.",
      "timestamp": "2026-07-23T12:36:52.018Z",
