      "status": "final"
    },
    {
      "id": "assistant_1781771170375",
      "role": "assistant",
      "text": "Understood, thanks for confirming. I'll update our records and make sure you don't get any more calls about Mind Your Business Inc.'s DHL account. Sorry again for the inconvenience.",
      "timestamp": "2026-06-18T08:26:10.390Z",
      "status": "final"
    },
    {
      "id": "customer_1781771171680_n9cs",
      "role": "customer",
      "text": "I don't have money.",
      "timestamp": "2026-06-18T08:26:11.680Z",
      "status": "final"
    },
    {
      "id": "assistant_1781771173711",
      "role": "assistant",
      "text": "I understand cash flow can be tight. Is there any way you can clear even part of the outstanding amount in the next 2 days? If not, please let me know when you expect to arrange payment, so I can update our records.",
