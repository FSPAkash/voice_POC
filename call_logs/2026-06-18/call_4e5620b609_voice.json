    },
    {
      "id": "customer_1781771124474_lcan",
      "role": "customer",
      "text": "Nopes",
      "timestamp": "2026-06-18T08:25:24.475Z",
      "status": "final"
    },
    {
      "id": "assistant_1781771126921",
      "role": "assistant",
      "text": "Alright, thanks for letting me know. Is there a better number or time to reach Mr Anthony or Mrs Anna Gressive regarding the DHL payment? If not, I'll try again later.",
      "timestamp": "2026-06-18T08:25:26.924Z",
      "status": "final"
    },
    {
      "id": "customer_1781771137968_61x2",
      "role": "customer",
      "text": "No, you are contacting the wrong person, no?",
      "timestamp": "2026-06-18T08:25:37.968Z",
      "status": "final"
    },
    {
      "id": "assistant_1781771138380",
      "role": "assistant",
      "text": "Apologies for the confusion. Could you please connect me to the person who handles accounts payable or payments for your company?",
      "timestamp": "2026-06-18T08:25:38.381Z",
      "status": "final"
    },
    {
      "id": "customer_1781771148574_o80o",
      "role": "customer",
      "text": "No, this is not the right company you are calling.",
      "timestamp": "2026-06-18T08:25:48.575Z",
      "status": "final"
    },
    {
      "id": "assistant_1781771152510",
      "role": "assistant",
      "text": "Thanks for clarifying. Sorry for the trouble. I'll update our records and make sure we don't call this number again.",
      "timestamp": "2026-06-18T08:25:52.510Z",
      "status": "final"
    },
    {
      "id": "customer_1781771152638_8gpi",
      "role": "customer",
      "text": "पूरा नहीं निकल रहा है।",
      "timestamp": "2026-06-18T08:25:52.639Z",
      "status": "final"
    },
    {
      "id": "system_1781771153030",
      "role": "system",
      "text": "Language coach: Reply in Hindi for the next turn.",
