    },
    {
      "id": "assistant_1781771187913",
      "role": "assistant",
      "text": "समझ गया, कोई दिक्कत नहीं. बस एक बार बता दीजिए, कब तक कुछ payment arrange कर पाएंगे? थोड़ा सा भी possible हो तो बता दीजिए, ताकि मैं note कर लूं और बार-बार call न करूं.",
      "timestamp": "2026-06-18T08:26:27.913Z",
      "status": "final"
    },
    {
      "id": "customer_1781771189885_lphk",
      "role": "customer",
      "text": "दाम हो रहा है।",
      "timestamp": "2026-06-18T08:26:29.908Z",
