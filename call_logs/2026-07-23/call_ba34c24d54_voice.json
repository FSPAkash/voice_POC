      "status": "final"
    },
    {
      "id": "assistant_1784810197185",
      "role": "assistant",
      "text": "Payment अभी तक hold क्यों है, थोड़ा बता दीजिए. मैं note कर लेता हूँ.",
      "timestamp": "2026-07-23T12:36:37.186Z",
